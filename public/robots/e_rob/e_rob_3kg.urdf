<?xml version="1.0"?>
<!--
  eRob 3 kg arm URDF asset.

  This file mirrors ZeroErrControl/eRob_ROS2_MoveIt:
  erobo3_control/config/eRobo3.urdf.xacro
    -> erob_arm/urdf/erob_arm.urdf

  The only local adaptation is replacing package://erob_arm mesh URLs with
  repo-local lowercase snake_case STL copies under mesh/official_erob_arm/.
-->
